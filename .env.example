# کپی کنید به .env و مقدار بدهید. این فایل را جایی منتشر نکنید.

# پورت اجرای سرور
PORT=3000

# اتصال به PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/zibadoz
DB_SSL=false

# حداقل ۳۲ کاراکتر تصادفی — برای ساخت کلید:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# محیط اجرا: development یا production
# در production، هدر HSTS فعال می‌شود و برخی هدرها سخت‌گیرانه‌تر اعمال می‌شوند.
NODE_ENV=development

# فقط هنگام اجرای پشت reverse proxy معتبر (Nginx/Caddy)
TRUST_PROXY=0

# در production اگر می‌خواهید همه ترافیک http به https هدایت شود
# (تنها زمانی فعال می‌شود که NODE_ENV=production هم باشد)
FORCE_HTTPS=0
